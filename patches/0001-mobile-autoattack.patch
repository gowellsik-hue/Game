diff --git a/Source/diablo.cpp b/Source/diablo.cpp
--- a/Source/diablo.cpp
+++ b/Source/diablo.cpp
@@
 bool gbShowIntro = true;
+
+bool MobileAutoAttackEnabled = true;
+bool MobileAutoAttackLatched = false;
+
+void TryMobileAutoAttack()
+{
+	if (!MobileAutoAttackEnabled || leveltype == DTYPE_TOWN || MyPlayer == nullptr
+	    || MyPlayerIsDead || PauseMode == 2 || gmenu_is_active()
+	    || SpellSelectFlag || QuestLogIsOpen || IsPlayerInStore()) {
+		MobileAutoAttackLatched = false;
+		return;
+	}
+
+	Player &player = *MyPlayer;
+	if (player._pmode != PM_STAND) {
+		MobileAutoAttackLatched = false;
+		return;
+	}
+
+	if (MobileAutoAttackLatched || pcursmonst < 0)
+		return;
+
+	Monster &monster = Monsters[pcursmonst];
+	if (monster._mhitpoints <= 0 || CanTalkToMonst(monster))
+		return;
+
+	LastPlayerAction = PlayerActionType::AttackMonsterTarget;
+	NetSendCmdParam1(true, player.UsesRangedWeapon() ? CMD_RATTACKID : CMD_ATTACKID, pcursmonst);
+	MobileAutoAttackLatched = true;
+}
@@
 		CheckCursMove();
 		plrctrls_after_check_curs_move();
+		TryMobileAutoAttack();
 		RepeatPlayerAction();
 	}
